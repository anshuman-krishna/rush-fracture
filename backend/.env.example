SERVER_ADDRESS=:8080
DATABASE_PATH=rush-fracture.db

# shared-secret gate for the whole api (except /health). generate a long
# random value for any non-local deploy — leaving this empty means the
# api has no auth at all.
API_KEY=

# comma-separated list of origins allowed to call this api from a browser.
# leave empty unless a web client (web-exported game, admin dashboard)
# needs to call it — native godot builds aren't subject to cors.
ALLOWED_ORIGINS=

# max requests per ip per minute before 429s start.
RATE_LIMIT_PER_MIN=120
